@echo off
setlocal
title M3U8 Playlist Generator

rem The BAT file's own directory is the library root.
set "M3U8_ROOT=%~dp0"
set "M3U8_BATCH=%~f0"

echo ========================================
echo       M3U8 PLAYLIST GENERATOR  v1.0.0
echo ========================================
echo.

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$text = [System.IO.File]::ReadAllText($env:M3U8_BATCH); $marker = '#<POWERSHELL>'; $index = $text.LastIndexOf($marker); if ($index -lt 0) { throw 'Embedded PowerShell section not found.' }; $code = $text.Substring($index + $marker.Length); & ([scriptblock]::Create($code))"
set "RESULT=%ERRORLEVEL%"

echo.
if not "%RESULT%"=="0" (
    echo Completed with errors. Check the warnings above.
) else (
    echo Completed successfully.
)
echo.
pause
exit /b %RESULT%
#<POWERSHELL>
$ErrorActionPreference = 'Stop'

# Written as the second line of every playlist this tool creates. Players treat
# it as a comment. It is how the tool recognises playlists it is allowed to
# overwrite, so hand-made playlists are never replaced.
$GeneratorTag = '# Generated by M3U8 Playlist Generator (Echolivity)'

$Root = [System.IO.Path]::GetFullPath($env:M3U8_ROOT)
if (-not [System.IO.Directory]::Exists($Root)) {
    throw "Root folder does not exist: $Root"
}

$Extensions = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
@('.mp3','.flac','.wav','.aac','.m4a','.ogg','.opus','.wma','.aiff','.aif') | ForEach-Object { [void]$Extensions.Add($_) }

$HiddenOrSystem = [System.IO.FileAttributes]::Hidden -bor [System.IO.FileAttributes]::System

# Natural sort that matches Windows Explorer. Compiling the helper can fail
# (for example when antivirus blocks the compiler), so fall back to a
# pure-PowerShell natural sort instead of stopping.
$Sorter = $null
try {
    if (-not ('M3U8NaturalFileSorter' -as [type])) {
        $source = @'
using System;
using System.IO;
using System.Collections.Generic;
using System.Runtime.InteropServices;
public sealed class M3U8NaturalFileSorter : IComparer<string>
{
    [DllImport("shlwapi.dll", CharSet = CharSet.Unicode)]
    private static extern int StrCmpLogicalW(string x, string y);
    public int Compare(string x, string y)
    {
        return StrCmpLogicalW(Path.GetFileName(x), Path.GetFileName(y));
    }
}
'@
        Add-Type -TypeDefinition $source -ErrorAction Stop
    }
    $Sorter = [M3U8NaturalFileSorter]::new()
}
catch {
    Write-Warning "Explorer-style sorting unavailable; using built-in natural sort instead. ($_)"
}

$NaturalKey = {
    [regex]::Replace([System.IO.Path]::GetFileName($_), '\d+', { $args[0].Value.PadLeft(20, '0') })
}

# True when an existing playlist was made by this tool and may be overwritten:
# it carries the generator tag, or it has exactly the shape that versions
# before 1.0.0 wrote (#EXTM3U, then #EXTINF:-1 lines and bare file names).
function Test-GeneratedPlaylist([string]$Path) {
    $Existing = [System.IO.File]::ReadAllLines($Path)
    if ($Existing.Count -eq 0) { return $true }
    if ($Existing -contains $GeneratorTag) { return $true }
    if ($Existing[0].TrimStart([char]0xFEFF) -ne '#EXTM3U') { return $false }
    for ($i = 1; $i -lt $Existing.Count; $i++) {
        $Line = $Existing[$i]
        if ($Line.Length -eq 0) { continue }
        if ($Line.StartsWith('#EXTINF:-1,')) { continue }
        if ($Line.StartsWith('#')) { return $false }
        if ($Line.IndexOfAny([char[]]@('\', '/', ':')) -ge 0) { return $false }
    }
    return $true
}

$Directories = [System.Collections.Generic.Stack[string]]::new()
$Directories.Push($Root)
$Utf8 = [System.Text.UTF8Encoding]::new($false)

$Folders = 0
$Tracks = 0
$Created = 0
$Updated = 0
$Unchanged = 0
$Protected = 0
$LinksSkipped = 0
$Errors = 0

Write-Host "Root: $Root" -ForegroundColor Cyan

while ($Directories.Count -gt 0) {
    $Folder = $Directories.Pop()
    $Folders++

    # Discover child directories.
    # - Hidden+system folders ($RECYCLE.BIN, System Volume Information) are skipped.
    # - Junctions and symbolic links are skipped to avoid loops and duplicates.
    # - Other reparse points, such as OneDrive Files On-Demand folders, are scanned.
    try {
        $DirEnum = [System.IO.Directory]::EnumerateDirectories($Folder).GetEnumerator()
        try {
            while ($DirEnum.MoveNext()) {
                $Child = $DirEnum.Current
                try {
                    $Attributes = [System.IO.File]::GetAttributes($Child)
                    if (($Attributes -band $HiddenOrSystem) -eq $HiddenOrSystem) { continue }

                    if (($Attributes -band [System.IO.FileAttributes]::ReparsePoint) -eq 0) {
                        $Directories.Push($Child)
                        continue
                    }

                    $LinkType = (Get-Item -LiteralPath $Child -Force -ErrorAction Stop).LinkType
                    if ($LinkType -eq 'Junction' -or $LinkType -eq 'SymbolicLink') {
                        $LinksSkipped++
                        Write-Host "Skipped link: $Child" -ForegroundColor DarkGray
                    }
                    else {
                        $Directories.Push($Child)
                    }
                }
                catch {
                    $Errors++
                    Write-Warning "Cannot inspect directory: $Child : $_"
                }
            }
        }
        catch {
            $Errors++
            Write-Warning "Directory enumeration failed: $Folder : $_"
        }
        finally { $DirEnum.Dispose() }
    }
    catch {
        $Errors++
        Write-Warning "Cannot access directories in: $Folder : $_"
    }

    # Collect files. If enumeration fails part-way through, skip this folder
    # rather than writing an incomplete playlist.
    $Files = [System.Collections.Generic.List[string]]::new()
    $FileScanOK = $true
    try {
        $FileEnum = [System.IO.Directory]::EnumerateFiles($Folder).GetEnumerator()
        try {
            while ($FileEnum.MoveNext()) {
                $File = $FileEnum.Current
                if (-not $Extensions.Contains([System.IO.Path]::GetExtension($File))) { continue }

                # macOS leaves "._name" companion files on shared drives; they are not audio.
                if ([System.IO.Path]::GetFileName($File).StartsWith('._')) { continue }

                try {
                    if (([System.IO.File]::GetAttributes($File) -band $HiddenOrSystem) -ne 0) { continue }
                }
                catch {
                    $Errors++
                    Write-Warning "Cannot inspect file; left out: $File : $_"
                    continue
                }

                $Files.Add($File)
            }
        }
        catch {
            $FileScanOK = $false
            $Errors++
            Write-Warning "File enumeration failed; folder skipped: $Folder : $_"
        }
        finally { $FileEnum.Dispose() }
    }
    catch {
        $FileScanOK = $false
        $Errors++
        Write-Warning "Cannot access files in: $Folder : $_"
    }

    if (-not $FileScanOK -or $Files.Count -eq 0) { continue }

    $FileArray = $Files.ToArray()
    if ($Sorter) {
        [Array]::Sort($FileArray, $Sorter)
    }
    else {
        $FileArray = @($FileArray | Sort-Object $NaturalKey)
    }

    $Lines = [System.Collections.Generic.List[string]]::new()
    [void]$Lines.Add('#EXTM3U')
    [void]$Lines.Add($GeneratorTag)
    foreach ($File in $FileArray) {
        $Name = [System.IO.Path]::GetFileName($File)
        $Title = [System.IO.Path]::GetFileNameWithoutExtension($File)
        [void]$Lines.Add("#EXTINF:-1,$Title")
        [void]$Lines.Add($Name)
    }

    $Leaf = [System.IO.Path]::GetFileName($Folder.TrimEnd([System.IO.Path]::DirectorySeparatorChar, [System.IO.Path]::AltDirectorySeparatorChar))
    if ([string]::IsNullOrWhiteSpace($Leaf)) { $Leaf = 'playlist' }
    $Output = [System.IO.Path]::Combine($Folder, "$Leaf.m3u8")
    $Content = [string]::Join([Environment]::NewLine, $Lines) + [Environment]::NewLine
    $Temp = "$Output.$([guid]::NewGuid().ToString('N')).tmp"

    try {
        if ([System.IO.File]::Exists($Output)) {
            $Existing = [System.IO.File]::ReadAllText($Output)
            if ($Existing -ceq $Content) {
                $Unchanged++
                $Tracks += $FileArray.Count
                continue
            }

            if (-not (Test-GeneratedPlaylist $Output)) {
                $Protected++
                Write-Host "Kept (not made by this tool): $Output" -ForegroundColor Yellow
                continue
            }

            [System.IO.File]::WriteAllText($Temp, $Content, $Utf8)
            # [NullString]::Value, not $null: PowerShell turns $null into "" for string
            # arguments, and File.Replace rejects an empty backup path.
            [System.IO.File]::Replace($Temp, $Output, [NullString]::Value)
            $Updated++
        }
        else {
            [System.IO.File]::WriteAllText($Temp, $Content, $Utf8)
            [System.IO.File]::Move($Temp, $Output)
            $Created++
        }

        $Tracks += $FileArray.Count
        Write-Host "Written: $Output ($($FileArray.Count) tracks)" -ForegroundColor Green
    }
    catch {
        $Errors++
        Write-Warning "Playlist write failed: $Output : $_"
    }
    finally {
        if ([System.IO.File]::Exists($Temp)) {
            try { [System.IO.File]::Delete($Temp) }
            catch { $Errors++; Write-Warning "Could not remove temporary file: $Temp" }
        }
    }
}

Write-Host ''
Write-Host '========================================' -ForegroundColor Cyan
Write-Host '       GENERATION COMPLETE' -ForegroundColor Cyan
Write-Host '========================================' -ForegroundColor Cyan
Write-Host "Folders scanned : $Folders"
Write-Host "Tracks indexed  : $Tracks"
Write-Host "Created         : $Created"
Write-Host "Updated         : $Updated"
Write-Host "Unchanged       : $Unchanged"
Write-Host "Kept (own)      : $Protected"
Write-Host "Links skipped   : $LinksSkipped"
Write-Host "Errors          : $Errors"
Write-Host '========================================' -ForegroundColor Cyan

if ($Errors -gt 0) { exit 1 } else { exit 0 }

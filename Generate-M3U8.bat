@echo off
setlocal
title M3U8 Playlist Generator v1.0.1

rem Generate-M3U8.bat v1.0.1
rem https://github.com/Echolivity/m3u8-playlist-generator
rem
rem Place this file in the root of a music library and run it. Every folder
rem that contains audio gets an M3U8 playlist named after the folder.
rem Set M3U8_NO_PAUSE=1 to skip the final "Press any key" (for scheduled runs).
rem Exit codes: 0 = success, 1 = finished with errors, 2 = stopped (fatal).

rem The BAT file's own directory is the library root.
set "M3U8_ROOT=%~dp0"
set "M3U8_BATCH=%~f0"

echo ========================================
echo     M3U8 PLAYLIST GENERATOR  v1.0.1
echo ========================================
echo.

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "try { $text = [System.IO.File]::ReadAllText($env:M3U8_BATCH); $marker = '#<POWERSHELL>'; $index = $text.LastIndexOf($marker); if ($index -lt 0) { throw 'Embedded PowerShell section not found.' }; $code = $text.Substring($index + $marker.Length); & ([scriptblock]::Create($code)) } catch { Write-Host ('FATAL: ' + $_) -ForegroundColor Red; exit 2 }"
set "RESULT=%ERRORLEVEL%"

echo.
if "%RESULT%"=="0" (
    echo Completed successfully.
) else if "%RESULT%"=="1" (
    echo Completed with errors. Check the warnings above.
) else (
    echo Stopped because of a fatal error. No further changes were made.
)
echo.
if not defined M3U8_NO_PAUSE pause
exit /b %RESULT%
#<POWERSHELL>
# Everything below runs in Windows PowerShell 5.1 (or PowerShell 7).
# Keep it compatible with PowerShell 5.1 and .NET Framework 4.5+.

$ErrorActionPreference = 'Stop'
$Version = '1.0.1'

# ----------------------------------------------------------------------------
# Settings
# ----------------------------------------------------------------------------

# Second line of every playlist this tool writes. Players treat it as a
# comment. It marks the playlist as generated, so the tool may update or
# remove it later. Playlists without it are never deleted.
$GeneratorTag = '# Generated by M3U8 Playlist Generator (Echolivity)'

$Extensions = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
foreach ($Ext in @('.mp3','.flac','.wav','.aac','.m4a','.ogg','.opus','.wma','.aiff','.aif')) { [void]$Extensions.Add($Ext) }

# UTF-8 without BOM. Throws on text that cannot be encoded or decoded, so a
# damaged name or a non-UTF-8 playlist is reported instead of silently mangled.
$Utf8 = [System.Text.UTF8Encoding]::new($false, $true)

$HiddenOrSystem = [System.IO.FileAttributes]::Hidden -bor [System.IO.FileAttributes]::System
$ReparsePoint   = [System.IO.FileAttributes]::ReparsePoint
$ReadOnly       = [System.IO.FileAttributes]::ReadOnly

# Characters that cannot appear in a Windows file name. A playlist entry that
# contains one is a path, not a bare file name, so it was not written by us.
$PathChars = [char[]]@('\', '/', ':', '*', '?', '"', '<', '>', '|')

# Work files written next to a playlist while it is replaced. Short, fixed-size
# names keep long-path failures to a minimum. Leftovers from an interrupted run
# are removed on a later run once they are older than $OrphanAge.
$WorkFile  = [regex]::new('^~M3U8-[0-9a-f]{16}\.(tmp|bak)$')
$OrphanAge = [System.TimeSpan]::FromMinutes(10)

# ----------------------------------------------------------------------------
# Natural sort
# ----------------------------------------------------------------------------

# Explorer's own comparison (StrCmpLogicalW). If the helper cannot be compiled
# or called, fall back to a pure-PowerShell natural sort instead of stopping.
$Sorter = $null
try {
    if (-not ('M3U8NaturalFileSorter' -as [type])) {
        $Source = @'
using System;
using System.Collections.Generic;
using System.Runtime.InteropServices;
public sealed class M3U8NaturalFileSorter : IComparer<string>
{
    [DllImport("shlwapi.dll", CharSet = CharSet.Unicode)]
    private static extern int StrCmpLogicalW(string x, string y);
    public int Compare(string x, string y)
    {
        return StrCmpLogicalW(x, y);
    }
}
'@
        Add-Type -TypeDefinition $Source -ErrorAction Stop
    }
    $Sorter = [M3U8NaturalFileSorter]::new()
    [void]$Sorter.Compare('Track 2', 'Track 10')
}
catch {
    $Sorter = $null
    Write-Warning "Explorer-style sorting unavailable; using built-in natural sort instead. ($_)"
}

$NaturalKey = { [regex]::Replace($_, '\d+', { $args[0].Value.PadLeft(20, '0') }) }

# ----------------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------------

# Playlist line for a file. Names that start with '#' would be read as a
# comment, and leading spaces are trimmed by some players, so those get '.\'.
function Get-EntryLine([string]$Name) {
    if ($Name[0] -eq '#' -or [char]::IsWhiteSpace($Name[0])) { return '.\' + $Name }
    return $Name
}

# Decides whether playlist text was written by this tool. Returns $null when
# ownership cannot be established, otherwise an object with:
#   Kind    'Generated' (has the tag; v1.0.0+) or 'Legacy' (exact pre-1.0.0 shape)
#   Entries the file names it lists
# Every line must match what the tool writes: '#EXTM3U', optional tag, then
# pairs of '#EXTINF:-1,<title>' and '<file name>' where the title is the file
# name without its extension and the extension is a supported audio type.
function Get-PlaylistOwnership([string]$Text) {
    if ($Text.Length -gt 0 -and $Text[0] -eq [char]0xFEFF) { $Text = $Text.Substring(1) }
    $Lines = $Text -split "`r`n|`n"
    $Count = $Lines.Count
    if ($Count -gt 0 -and $Lines[$Count - 1].Length -eq 0) { $Count-- }
    if ($Count -lt 3 -or $Lines[0] -cne '#EXTM3U') { return $null }

    $Tagged = $Lines[1] -ceq $GeneratorTag
    $i = 1
    if ($Tagged) { $i = 2 }
    if ((($Count - $i) % 2) -ne 0 -or $Count -eq $i) { return $null }

    $Entries = [System.Collections.Generic.List[string]]::new()
    for (; $i -lt $Count; $i += 2) {
        $Info = $Lines[$i]
        $Name = $Lines[$i + 1]
        if (-not $Info.StartsWith('#EXTINF:-1,', [System.StringComparison]::Ordinal)) { return $null }
        if ($Tagged -and $Name.StartsWith('.\', [System.StringComparison]::Ordinal)) { $Name = $Name.Substring(2) }
        if ($Name.Length -eq 0 -or $Name.IndexOfAny($PathChars) -ge 0) { return $null }
        if (-not $Extensions.Contains([System.IO.Path]::GetExtension($Name))) { return $null }
        if ($Info.Substring(11) -cne [System.IO.Path]::GetFileNameWithoutExtension($Name)) { return $null }
        $Entries.Add($Name)
    }

    $Kind = 'Legacy'
    if ($Tagged) { $Kind = 'Generated' }
    return [pscustomobject]@{ Kind = $Kind; Entries = $Entries }
}

function Read-PlaylistText([string]$Path) {
    return [System.IO.File]::ReadAllText($Path, $Utf8)
}

function New-WorkPath([string]$Folder, [string]$Extension) {
    return [System.IO.Path]::Combine($Folder, '~M3U8-' + [guid]::NewGuid().ToString('N').Substring(0, 16) + $Extension)
}

# Writes the playlist so that a failure never leaves a damaged or missing
# playlist behind:
#   1. Write the full content to a work file and flush it to disk.
#   2. New playlist: rename the work file into place.
#      Existing playlist: swap it in with File.Replace (Windows ReplaceFile),
#      keeping the old file as a backup until the swap has succeeded.
#   3. If the swap fails after the old file was moved aside, move it back.
# ReplaceFile is not guaranteed to be atomic on every file system (for example
# some network shares); this procedure is what keeps the old playlist safe.
function Write-Playlist([string]$Folder, [string]$Output, [string]$Content) {
    $Temp = New-WorkPath $Folder '.tmp'
    $Backup = New-WorkPath $Folder '.bak'
    try {
        $Bytes = $Utf8.GetBytes($Content)
        $Stream = [System.IO.FileStream]::new($Temp, [System.IO.FileMode]::CreateNew, [System.IO.FileAccess]::Write, [System.IO.FileShare]::None)
        try {
            $Stream.Write($Bytes, 0, $Bytes.Length)
            $Stream.Flush($true)
        }
        finally { $Stream.Dispose() }

        # @fault-point: after-temp-write

        if ([System.IO.File]::Exists($Output)) {
            try {
                [System.IO.File]::Replace($Temp, $Output, $Backup)
            }
            catch {
                if (-not [System.IO.File]::Exists($Output) -and [System.IO.File]::Exists($Backup)) {
                    try { [System.IO.File]::Move($Backup, $Output) }
                    catch { Write-Warning "Previous playlist could not be restored; it is preserved as: $Backup" }
                }
                throw
            }

            # @fault-point: after-replace

            try { [System.IO.File]::Delete($Backup) }
            catch { Write-Warning "Could not remove backup (it will be cleaned up on a later run): $Backup" }
        }
        else {
            [System.IO.File]::Move($Temp, $Output)
        }
    }
    finally {
        if ([System.IO.File]::Exists($Temp)) {
            try { [System.IO.File]::Delete($Temp) }
            catch { Write-Warning "Could not remove work file (it will be cleaned up on a later run): $Temp" }
        }
    }
}

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------

try {
    $Root = [System.IO.Path]::GetFullPath($env:M3U8_ROOT)
    if (-not [System.IO.Directory]::Exists($Root)) {
        throw "Root folder does not exist: $Root"
    }
}
catch {
    Write-Host "FATAL: $_" -ForegroundColor Red
    exit 2
}

$Directories = [System.Collections.Generic.Stack[string]]::new()
$Directories.Push($Root)

$Folders = 0
$Tracks = 0
$Created = 0
$Updated = 0
$Unchanged = 0
$KeptForeign = 0
$KeptReadOnly = 0
$StaleRemoved = 0
$WorkFilesRemoved = 0
$LinksSkipped = 0
$HiddenSkipped = 0
$Errors = 0

Write-Host "Root: $Root" -ForegroundColor Cyan

while ($Directories.Count -gt 0) {
    $Folder = $Directories.Pop()
    $Folders++

    # One pass over the folder collects subfolders, audio files, playlists and
    # leftover work files. Attributes come from the directory listing itself,
    # so no extra file-system call is made per file.
    $AudioNames = [System.Collections.Generic.List[string]]::new()
    $Playlists = [System.Collections.Generic.List[System.IO.FileInfo]]::new()
    $WorkFiles = [System.Collections.Generic.List[System.IO.FileInfo]]::new()
    $SubFolders = [System.Collections.Generic.List[string]]::new()

    try {
        $Enum = ([System.IO.DirectoryInfo]::new($Folder)).EnumerateFileSystemInfos().GetEnumerator()
        try {
            while ($Enum.MoveNext()) {
                $Item = $Enum.Current
                $Attr = $Item.Attributes

                if ($Item -is [System.IO.DirectoryInfo]) {
                    # Hidden or system folders ($RECYCLE.BIN, System Volume Information, ...)
                    if (($Attr -band $HiddenOrSystem) -ne 0) { $HiddenSkipped++; continue }

                    # Junctions and symbolic links are skipped to avoid loops and
                    # duplicates. Other reparse points, such as OneDrive Files
                    # On-Demand folders, are scanned.
                    if (($Attr -band $ReparsePoint) -ne 0) {
                        try { $LinkType = (Get-Item -LiteralPath $Item.FullName -Force -ErrorAction Stop).LinkType }
                        catch {
                            $Errors++
                            Write-Warning "Cannot inspect folder; skipped: $($Item.FullName) : $_"
                            continue
                        }
                        if ($LinkType -eq 'Junction' -or $LinkType -eq 'SymbolicLink') {
                            $LinksSkipped++
                            Write-Host "Skipped link: $($Item.FullName)" -ForegroundColor DarkGray
                            continue
                        }
                    }
                    $SubFolders.Add($Item.FullName)
                    continue
                }

                $Name = $Item.Name
                if ($WorkFile.IsMatch($Name)) { $WorkFiles.Add([System.IO.FileInfo]$Item); continue }
                if (($Attr -band $HiddenOrSystem) -ne 0) { continue }

                $Extension = $Item.Extension
                if ($Extension -ieq '.m3u8') { $Playlists.Add([System.IO.FileInfo]$Item); continue }
                if (-not $Extensions.Contains($Extension)) { continue }

                # macOS leaves "._name" companion files on shared drives; they are not audio.
                if ($Name.StartsWith('._', [System.StringComparison]::Ordinal)) { continue }

                try { [void]$Utf8.GetByteCount($Name) }
                catch {
                    $Errors++
                    Write-Warning "File name cannot be written as UTF-8; left out: $($Item.FullName)"
                    continue
                }

                $AudioNames.Add($Name)
            }
        }
        finally { $Enum.Dispose() }
    }
    catch {
        # The listing is incomplete. Change nothing in this folder: no playlist
        # is written or removed on the basis of a partial view.
        $Errors++
        Write-Warning "Folder could not be read; left unchanged: $Folder : $_"
        continue
    }

    foreach ($Sub in $SubFolders) { $Directories.Push($Sub) }

    # --- Leftover work files from an interrupted run -------------------------
    foreach ($Work in $WorkFiles) {
        try {
            if (([datetime]::UtcNow - $Work.LastWriteTimeUtc) -lt $OrphanAge) { continue }
            if ($Work.Extension -ieq '.bak') {
                # A backup is only removed if it is one of our own playlists;
                # anything else is left for the user.
                $Owner = $null
                try { $Owner = Get-PlaylistOwnership (Read-PlaylistText $Work.FullName) } catch [System.Text.DecoderFallbackException] { <# not UTF-8: ownership unknown #> }
                if ($null -eq $Owner) {
                    Write-Warning "Leftover backup kept (contents not recognised): $($Work.FullName)"
                    continue
                }
            }
            $Work.Delete()
            $WorkFilesRemoved++
            Write-Host "Removed leftover work file: $($Work.FullName)" -ForegroundColor DarkGray
        }
        catch {
            $Errors++
            Write-Warning "Could not remove leftover work file: $($Work.FullName) : $_"
        }
    }

    $Leaf = [System.IO.Path]::GetFileName($Folder.TrimEnd([System.IO.Path]::DirectorySeparatorChar, [System.IO.Path]::AltDirectorySeparatorChar))
    if ([string]::IsNullOrWhiteSpace($Leaf)) { $Leaf = 'playlist' }
    $PlaylistName = "$Leaf.m3u8"
    $Output = [System.IO.Path]::Combine($Folder, $PlaylistName)

    # --- Write or update this folder's playlist -----------------------------
    if ($AudioNames.Count -gt 0) {
        $Names = $AudioNames.ToArray()
        if ($null -ne $Sorter) { [Array]::Sort($Names, $Sorter) }
        else { $Names = [string[]]@($Names | Sort-Object $NaturalKey) }

        $Builder = [System.Text.StringBuilder]::new()
        [void]$Builder.Append('#EXTM3U').Append("`r`n")
        [void]$Builder.Append($GeneratorTag).Append("`r`n")
        foreach ($Name in $Names) {
            [void]$Builder.Append('#EXTINF:-1,').Append([System.IO.Path]::GetFileNameWithoutExtension($Name)).Append("`r`n")
            [void]$Builder.Append((Get-EntryLine $Name)).Append("`r`n")
        }
        $Content = $Builder.ToString()
        $Tracks += $Names.Count

        try {
            if ([System.IO.File]::Exists($Output)) {
                $Existing = $null
                try { $Existing = Read-PlaylistText $Output } catch [System.Text.DecoderFallbackException] { <# not UTF-8: ownership unknown #> }

                if ($null -ne $Existing -and $Existing -ceq $Content) {
                    $Unchanged++
                }
                elseif ($null -eq $Existing -or $null -eq (Get-PlaylistOwnership $Existing)) {
                    $KeptForeign++
                    Write-Host "Kept (not made by this tool): $Output" -ForegroundColor Yellow
                }
                elseif (([System.IO.File]::GetAttributes($Output) -band $ReadOnly) -ne 0) {
                    $KeptReadOnly++
                    Write-Host "Kept (read-only, not updated): $Output" -ForegroundColor Yellow
                }
                else {
                    Write-Playlist $Folder $Output $Content
                    $Updated++
                    Write-Host "Updated: $Output ($($Names.Count) tracks)" -ForegroundColor Green
                }
            }
            else {
                Write-Playlist $Folder $Output $Content
                $Created++
                Write-Host "Created: $Output ($($Names.Count) tracks)" -ForegroundColor Green
            }
        }
        catch {
            $Errors++
            Write-Warning "Playlist write failed; existing playlist left as it was: $Output : $_"
        }
    }

    # --- Remove stale generated playlists -----------------------------------
    # Policy (only tagged playlists are ever removed; read-only ones are kept):
    #   * Folder has no audio: remove '<folder>.m3u8' if it is a generated playlist.
    #   * Folder has audio: remove another generated playlist only if its content
    #     is identical to this folder's playlist, i.e. the copy left behind when
    #     the folder was renamed. Curated or reordered copies are kept.
    if ($Playlists.Count -gt 0) {
        foreach ($Playlist in $Playlists) {
            $IsOwnName = $Playlist.Name -ieq $PlaylistName
            if ($AudioNames.Count -gt 0 -and $IsOwnName) { continue }
            if ($AudioNames.Count -eq 0 -and -not $IsOwnName) { continue }

            try {
                $Owner = $null
                $Text = $null
                try { $Text = Read-PlaylistText $Playlist.FullName } catch [System.Text.DecoderFallbackException] { <# not UTF-8: ownership unknown #> }
                if ($null -eq $Text) { continue }
                if ($AudioNames.Count -gt 0) {
                    if ($Text -cne $Content) { continue }
                }
                else {
                    $Owner = Get-PlaylistOwnership $Text
                    if ($null -eq $Owner -or $Owner.Kind -ne 'Generated') { continue }
                }

                if (($Playlist.Attributes -band $ReadOnly) -ne 0) {
                    $KeptReadOnly++
                    Write-Host "Kept (read-only, stale): $($Playlist.FullName)" -ForegroundColor Yellow
                    continue
                }

                # @fault-point: before-stale-delete
                $Playlist.Delete()
                $StaleRemoved++
                Write-Host "Removed stale playlist: $($Playlist.FullName)" -ForegroundColor Magenta
            }
            catch {
                $Errors++
                Write-Warning "Could not check or remove stale playlist: $($Playlist.FullName) : $_"
            }
        }
    }
}

Write-Host ''
Write-Host '========================================' -ForegroundColor Cyan
Write-Host "     GENERATION COMPLETE  (v$Version)" -ForegroundColor Cyan
Write-Host '========================================' -ForegroundColor Cyan
Write-Host "Folders scanned      : $Folders"
Write-Host "Tracks indexed       : $Tracks"
Write-Host "Playlists created    : $Created"
Write-Host "Playlists updated    : $Updated"
Write-Host "Playlists unchanged  : $Unchanged"
Write-Host "Stale removed        : $StaleRemoved"
Write-Host "Kept (not ours)      : $KeptForeign"
Write-Host "Kept (read-only)     : $KeptReadOnly"
Write-Host "Work files cleaned   : $WorkFilesRemoved"
Write-Host "Links skipped        : $LinksSkipped"
Write-Host "Hidden/system skipped: $HiddenSkipped"
Write-Host "Errors               : $Errors"
Write-Host '========================================' -ForegroundColor Cyan

if ($Errors -gt 0) { exit 1 } else { exit 0 }
